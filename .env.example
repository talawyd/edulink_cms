# Copy this file to .env and fill in the TPIC project's values.
# These are the TPIC project's own address and its PUBLISHABLE key. Nothing else.
# Never put a secret key (sb_secret_...) here. Vite publishes every VITE_ value to the browser.
VITE_SUPABASE_URL=https://YOUR_TPIC_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
